# Copy to `.env` (git-ignored) and fill in. Loaded into the orchestrator run's
# environment. NEVER commit real values — webhook URLs embed secret tokens.

# --- Orchestrator notification channel (DMI-68, used by scripts/notify.sh) ---
# Where escalations are POSTed so a human actually finds out. Any endpoint that
# accepts an HTTP POST works — the loop is deliberately channel-agnostic.
# If unset, notify.sh is a best-effort no-op (the Linear comment is still the
# durable record of the escalation).
ORCHESTRATOR_NOTIFY_WEBHOOK=

# Payload shape for the webhook. One of: slack | ntfy | telegram | raw
#   slack     JSON {"text": "..."} — also works for Discord / Mattermost / Google Chat
#   ntfy      plain body, title sent as a header (ntfy.sh)
#   telegram  form POST to the Bot API sendMessage endpoint (see chat id below)
#   raw       message sent as the raw text/plain body
# Defaults to slack when unset.
ORCHESTRATOR_NOTIFY_FORMAT=slack

# Only for ORCHESTRATOR_NOTIFY_FORMAT=telegram. The WEBHOOK is then the Bot API
# URL, e.g. https://api.telegram.org/bot<token>/sendMessage
ORCHESTRATOR_NOTIFY_TELEGRAM_CHAT_ID=
