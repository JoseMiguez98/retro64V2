{
  "name": "retro64v2",
  "private": true,
  "version": "0.0.0",
  "description": "Play retro games online with friends in the browser. Monorepo root.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @retro64/web dev",
    "dev:signaling": "pnpm --filter @retro64/signaling dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @retro64/e2e test",
    "test:e2e": "pnpm --filter @retro64/e2e test",
    "test:e2e:headed": "pnpm --filter @retro64/e2e test:headed",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  }
}
